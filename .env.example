# ==============================================================================
# Kevin's Residential Construction Operations Hub - Environment Variables Template
# ==============================================================================

# 1. Notion API Authentication
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_PAGE_ID=your_parent_page_id_here

# 2. Notion Relational Database IDs
NOTION_CONTACTS_DB_ID=your_contacts_db_id_here
NOTION_OPPORTUNITIES_DB_ID=your_opportunities_db_id_here
NOTION_SALES_ACTIVITIES_DB_ID=your_sales_activities_db_id_here
NOTION_PROJECTS_DB_ID=your_projects_db_id_here
NOTION_MILESTONES_DB_ID=your_milestones_db_id_here
NOTION_MATERIALS_DB_ID=your_materials_db_id_here
NOTION_DECISION_LOG_DB_ID=your_decision_log_db_id_here
NOTION_COSTS_DB_ID=your_costs_db_id_here

# 3. n8n Automation Webhook & Service Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/invoice-upload
NOTIFY_EMAIL=kevin@kevinconstruction.com

# 4. Optional: OCR & AI Extraction API Keys
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
