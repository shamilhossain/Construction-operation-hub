# Notion API Configuration
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Copy the "Internal Integration Secret" and paste below as NOTION_TOKEN
NOTION_TOKEN=secret_your_notion_integration_token_here

# 3. Create or open a parent page in Notion (e.g. "Kevin Construction Hub")
# 4. In the top right corner of the page, click "..." -> "Connections" -> add your integration
# 5. Copy the link to the page and extract the 32-character page ID (or paste the full URL)
NOTION_PAGE_ID=your_parent_page_id_here
